<div class="seminar-page">
  <header>
    <% @seminars.each do |seminar| %>
      <h1 class="page-title">
        <%= seminar.title %>
      </h1>
    <% end %>

    <div class="page-speaker">
      <span class="page-speaker-label">seminario tenuto da</span>
      <span><%= @seminars.first.speaker %></span>
    </div>
  </header>

  <% @seminars.each do |seminar| %>
    <section class="page-event">
      <div class="page-event-grid">
        <div class="page-date">
          <%= render DayTagComponent.new(seminar) %>
        </div>
        <div class="page-details">
          <%= render ArgumentsTagComponent.new(seminar) %>
          <%= render HourTagComponent.new(seminar) %>
          <%= render WhereTagComponent.new(seminar) %>
          <%= seminar_link_tag seminar %>
          <% if seminar.serial_id || seminar.cycle_id %>
            <div class="page-notes">
              <% if seminar.serial_id %>
                <div>
                  <span class="page-note-label">nell'ambito della serie:</span>
                  <%= link_to seminar.serial.to_s.upcase, serial_path(seminar.serial_id) %>
                </div>
              <% end %>
              <% if seminar.cycle_id %>
                <div>
                  <span class="page-note-label">nel ciclo di seminari:</span>
                  <%= link_to seminar.cycle.to_s.upcase, cycle_path(seminar.cycle_id) %>
                </div>
              <% end %>
            </div>
          <% end %>
          <div class="page-abstract">
            <% if seminar.abstract.blank? %>
              TBA
            <% else %>
              <%= seminar.abstract %>
            <% end %>
          </div>

        </div>
      </div>

      <div class="page-attachments">
        <% if seminar.documents.any? %>
          <dl>
            <dt>Allegati:</dt>
            <% seminar.documents.each do |document| %>
              <dd><%= document_tag(document) %></dd>
            <% end %>
          </dl>
        <% end %>

        <div class="page-footer">
          <% unless seminar.conference_id %>
            <div class="committee">
              <%= t :organized_by %> <%= seminar.committee %> <br/>
              <%= seminar.project %>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>
</div>

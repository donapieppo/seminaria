<div class="date text-center px-2">
  <div class="date-month">
    <%= l(@date, format: :month).capitalize %>
  </div>
  <div>
    <% if @conference %>
      <div class="my-2">
        <% if @conference && @conference.start_date != @conference.end_date%>
          dal giorno <br/>
          <span class="fw-bold"><%= l @conference.start_date %></span><br/>
          al giorno<br/>
          <span class="fw-bold"><%= l @conference.end_date %></span>
        <% else %>
          del <%= l @conference.start_date %>
        <% end %>
      </div>
    <% else %>
      <div class="date-day"><%= l @date, format: :nday %></div>
      <div><%= @detail %></div>
    <% end %>
  </div>
</div>
